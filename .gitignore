# Python 字节码缓存，每次运行都会生成，绝不能提交
__pycache__/
*.py[cod]

# 虚拟环境（本项目用全局 Python，但别把别人的 venv 提交上来）
venv/
.venv/
env/

# pytest 自己的缓存目录
.pytest_cache/

# allure 的原始结果和渲染后的 HTML 报告
# 报告是"运行产物"，不是源码，每次执行都会重新生成
allure-results/
allure-report/

# 运行日志
logs/
*.log

# 其他报告输出（含 UI 自动化的截图与录像）
report/
reports/

# 编辑器/IDE 的个人配置
.idea/
.vscode/

# 操作系统垃圾文件
.DS_Store
Thumbs.db

# 个人开发笔记，只留在本地，绝不进仓库
docs/dev-notes.md

pytest-cache-files-*/

test_demo_checker.py
